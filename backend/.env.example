# ============================================================
# LLM Providers
# ============================================================

# OpenRouter — light/bulk work: source summaries, SQL drafting, embeddings
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# GMI Cloud — heavy reasoning (routing agent). Free MiniMax models only:
#   MiniMaxAI/MiniMax-M2.7   MiniMaxAI/MiniMax-M3
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
ROUTER_MODEL=MiniMaxAI/MiniMax-M2.7

# Optional / unused by default
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
LANGSMITH_API_KEY=


# ============================================================
# Qdrant
# ============================================================

# Set QDRANT_URL (+ QDRANT_API_KEY) for Qdrant Cloud.
# Leave QDRANT_URL empty to use the local host/port instance.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=agentic_rag


# ============================================================
# Application
# ============================================================

PROJECT_NAME=Dynamic Agentic Systems
DEBUG=false
LOG_LEVEL=INFO

# CORS_ORIGINS is a List[str] — pydantic-settings needs JSON if you set it.
# Unset uses the code default (localhost:3000 + :8000).
# CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]


# ============================================================
# SQL / Structured Data
# ============================================================

SQL_MAX_ROWS=200
SQL_SAMPLE_ROWS=2


# ============================================================
# Databases (optional)
# ============================================================

POSTGRES_URI=
MONGODB_URI=
